PORT=3000
FRONTEND_URL=https://ashqe.app
API_URL=https://ashqe.app/api

# Deep Linking / Share settings
APP_PACKAGE_NAME=com.ashqe.app
APP_SCHEME=ashqe
APP_STORE_ID=123456789

# MongoDB Connection (Atlas) — must use /ashqe database name
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ashqe?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.pdh6cp6.mongodb.net/ashqe?retryWrites=true&w=majority

# Redis Connection
REDIS_URI=redis://localhost:6379

# Storage driver: local | s3  (default s3 when credentials are set)
STORAGE_DRIVER=s3

# AWS S3 Configuration
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=ashqe-ott
AWS_S3_REGION=us-east-1
# Optional CloudFront / custom CDN base (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Video transcoder: auto (MediaConvert if role set, else local ffmpeg) | aws | local
VIDEO_TRANSCODER=auto
# AWS Elemental MediaConvert (optional — same-quality ABR HLS with QVBR, less space)
# Create an IAM role that MediaConvert can assume with S3 read/write on your bucket.
# AWS_MEDIACONVERT_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/MediaConvert_Default_Role
# AWS_MEDIACONVERT_QUEUE=arn:aws:mediaconvert:REGION:ACCOUNT_ID:queues/Default
# AWS_MEDIACONVERT_ENDPOINT=https://xxxxx.mediaconvert.REGION.amazonaws.com

# Message Central VerifyNow OTP (also configurable in Admin → Settings → SMS / OTP)
MC_ENABLED=false
MC_CUSTOMER_ID=
MC_AUTH_TOKEN=
MC_BASE_URL=https://cpaas.messagecentral.com
MC_COUNTRY_CODE=91
MC_OTP_LENGTH=4
MC_FLOW_TYPE=SMS
# Optional fallback if Auth Token empty
# MC_EMAIL=you@example.com
# MC_PASSWORD=your-password
# Dev only — allows OTP 1234 when MC not configured
# ALLOW_STATIC_OTP=true
